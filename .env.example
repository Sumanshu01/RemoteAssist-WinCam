# ==============================================================================
# RemoteAssist WinCam - Environment Configuration Template
# NEVER commit real credentials or .env files to source control!
# ==============================================================================

# Node Environment
NODE_ENV=development

# Signaling Server Configuration
SIGNALING_PORT=4000
SIGNALING_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/remoteassist_wincam?schema=public

# STUN / TURN Configuration (Cross-border India <-> Canada traversal)
# Google Public STUN servers (used for testing NAT traversal)
STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN Server (Optional for restrictive symmetric NATs)
TURN_SERVER_URL=turn:turn.remoteassist-wincam.org:3478
TURN_USERNAME=user
TURN_CREDENTIAL=credential_secret

# Session Security & Consent
SESSION_EXPIRY_MINUTES=30
REQUIRE_EXPLICIT_TWO_PARTY_CONSENT=true
CONSENT_AUDIT_LOG_ENABLED=true

# Web Dashboard (Frontend)
VITE_SIGNALING_SERVER_URL=http://localhost:4000
VITE_APP_TITLE=RemoteAssist WinCam
VITE_DEFAULT_ORIGIN_REGION=India (IN)
VITE_DEFAULT_REMOTE_REGION=Canada (CA)

# Sender Client (Frontend)
VITE_SENDER_PORT=5174
VITE_SENDER_SIGNALING_URL=http://localhost:4000

# Native Receiver Service Integration
NATIVE_RECEIVER_TCP_PORT=9002
NATIVE_RECEIVER_SHM_NAME=RemoteAssist_WinCam_FrameBuffer
